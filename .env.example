# ===== 密钥配置模板（可提交到 git，供他人参考格式）=====
# 复制本文件为 .env 并填入你的真实 key；真实 .env 已被 .gitignore 忽略

# DeepSeek API key（在 https://platform.deepseek.com 创建）
DEEPSEEK_API_KEY=sk-你的key

# Tavily 搜索 API key（在 https://app.tavily.com 注册获取）
TAVILY_API_KEY=tvly-你的key

# 以下为可选高级配置
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash         # 默认锁定 flash
# DEEPSEEK_REASONING_EFFORT=high           # 推理强度: low/medium/high
# DEEPSEEK_THINKING=true                   # 思考模式开关: true/false
